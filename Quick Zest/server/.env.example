# ---- Server ----
PORT=5000
NODE_ENV=development
TZ=Asia/Kolkata
# The dashboard (Next.js) URL. In production: your Vercel URL, e.g. https://QuickZest-admin.vercel.app
CLIENT_URL=http://localhost:3000

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/Quick Zest
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/QuickZest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/QuickZest

# ---- Security ----
# Long random string (production requires 32+ chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12

# ---- Admin account ----
# Created automatically on first start if no admin exists. `npm run seed:admin` resets the password.
# Sign in right after deploying: the first sign-in links your phone.
ADMIN_NAME=Quick Zest Admin
ADMIN_EMAIL=admin@QuickZest.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Two-factor sign-in ----
# Uses a free authenticator app (Google/Microsoft Authenticator). Nothing to configure:
# the first sign-in shows a QR code to scan. Lost phone + backup codes? `npm run reset-2fa`.
# NOTE: keep JWT_SECRET the same forever — it also encrypts the authenticator keys.

# ---- Chatbot (optional) ----
# Works without a key using built-in answers from your data.
# Add an Anthropic API key to let it answer free-form questions too.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
